,cAAS,CACT,KAAI,CACJ,UAAM,CACN,UAAQ,CAEV,gJAKE,kBAAe,CAEjB,4DACE,wBAAiB,CACjB,YAAQ,CAEV,iCACE,mBAAe,CACf,kBAAY,CACZ,YAAQ,CACR,WAAO,CACP,iBAAS,CACT,UAAQ,CAER,wCACE,kBAAW,CACX,aAAM,CACN,WAAQ,CACR,QAAO,CACP,eAAc,CAEhB,mCACE,wBAAiB,CACjB,aAAM,CACN,WAAQ,CACR,UAAQ,CAEV,yCACE,wBAAiB,CACjB,UAAM,CAEV,sCACE,KAAI,CACJ,MAAK,CAEP,uCACE,KAAI,CACJ,OAAM,CAEgB,yBACtB,0BACE,YAAQ,CAAA,CApHZ,0BACE,KAAO,SAAS,CAChB,GAAK,SAAS,CAAA,CAoHlB,+DAEI,SAAO,CACP,UAAQ,CAGZ,2EAEI,kBAAY,CAGhB,2EAEI,0BAAY,CACZ,eAAe,CAGnB,uFAEI,2BAAY,CAGhB,iBACE,yCAAiB,CACjB,qBAAQ,CAER,8BACE,6BAAW,CACX,qBAAM,CACN,4BAAc,CACd,gCAAQ,CAEV,8BACE,qBAAM,CACN,yBAAU,CACV,0BAAY,CACZ,mBAAO,CAET,uCACE,wBAAM,CACN,yBAAU,CACV,0BAAY,CACZ,mBAAO,CAET,6BACE,uBAAW,CACX,2BAAa,CAEb,2CACE,+BAAa,CACb,wBAAM,CAEN,+DACE,yBAAU,CAEhB,gCACE,qBAAI,CACJ,0BAAW,CACX,qBAAM,CACN,iCAAgB,CAElB,+DACE,6BAAW,CACX,qBAAM,CACN,8BAAc,CACd,4BAAQ,CACR,0BAAY,CACZ,sBAAO,CACP,yBAAU,CACV,mBAAO,CACP,uBAAW,CAEX,2EACE,0BAAW,CAEf,qCACE,gCAAiB,CACjB,qBAAM,CAER,sCACE,gCAAiB,CACjB,wBAAM,CAER,8BACE,6BAAW,CACX,qBAAM,CACN,mCAAO,CACP,4BAAc,CACd,0BAAW,CACX,sBAAO,CACP,2BAAO,CAEP,oCACE,4BAAa,CACb,0BAAW","sourcesContent":["$primary=#00FF99\n$primaryhover=lighten(#00FF99, 35%)\n\n$bg=#18181B\n$bgdark=#09090B\n$bglight=#18181B\n$bglighter=lighten(#18181B, 10%)\n\n$red=#00FF99\n$green=#22D3EE\n$orange=#d66853\n\n$black=#222\n$gray=#262626\n$grayalt=#323232\n$grayhover=#444\n\n$lightgray=#AAA\n$white=#A3A3A3\n\n$normalfont=system-ui, BlinkMacSystemFont, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif\n$monospace=system-ui, BlinkMacSystemFont, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif\n\nmedia--1024() {\n  @media (min-width: 1024px) {\n    {block}\n  }\n}\n\n/* CSS rules from the original FontAwesomeIcon component */\nsvg:not(:root).svg-inline--fa, svg:not(:host).svg-inline--fa {\n  overflow: visible;\n  box-sizing: content-box;\n}\n\n.svg-inline--fa {\n  display: inline-block;\n  height: 1em;\n  overflow: visible;\n  vertical-align: -0.125em;\n}\n","@import './lib';\n\nbody.aframe-inspector-opened,\n.toggle-edit\n  font-family BlinkMacSystemFont, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif\n\n.wf-roboto-n4-active body.aframe-inspector-opened,\n.wf-roboto-n4-active .toggle-edit\n  font-family BlinkMacSystemFont, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif\n\nbody.aframe-inspector-opened\n  background $bgdark\n  color #fff\n  font-size 12px\n  margin 0\n  overflow hidden\n\n#aframeInspector\n  // Keep editor controls separate from host-page styling and layout.\n  position fixed\n  inset 0\n  z-index 10\n  pointer-events none\n\n  @import './scenegraph';\n  @import './components';\n  @import './entity';\n  @import './help';\n  @import './select';\n  @import './textureModal';\n  @import './viewport';\n  @import './widgets';\n  @import './primitiveModal';\n\n  .error-boundary\n    position fixed\n    top 0\n    left 0\n    width 100%\n    height 100%\n    display flex\n    align-items center\n    justify-content center\n    background rgba(0, 0, 0, 0.9)\n    z-index 9999\n    pointer-events all\n\n    .error-content\n      background #1e1e1e\n      border 1px solid #ff4444\n      border-radius 8px\n      padding 24px 32px\n      max-width 500px\n      text-align center\n\n      h2\n        color #ff4444\n        margin 0 0 16px 0\n        font-size 18px\n\n      p\n        color #a3a3a3\n        margin 0 0 16px 0\n\n      pre\n        background #0d0d0d\n        color #ff6b6b\n        padding 12px\n        border-radius 4px\n        font-size 12px\n        overflow-x auto\n        text-align left\n        margin 0 0 16px 0\n\n      button\n        background #00ff99\n        color #000\n        border none\n        padding 10px 24px\n        border-radius 4px\n        cursor pointer\n        font-weight 500\n        font-size 14px\n\n        &:hover\n          background #00cc7a\n\n  .Select,\n  code,\n  pre,\n  input,\n  textarea,\n  select\n    font-family $monospace\n    font-size 14px\n\n  .wf-robotomono-n4-active .Select,\n  .wf-robotomono-n4-active code,\n  .wf-robotomono-n4-active pre,\n  .wf-robotomono-n4-active input,\n  .wf-robotomono-n4-active textarea,\n  .wf-robotomono-n4-active select\n    font-family Roboto Mono, Consolas, Andale Mono, Monaco, Courier New, monospace\n\n  hr\n    border 0\n    border-top 1px solid #ccc\n\n  a\n    cursor pointer\n\n  button\n    position relative\n    appearance none\n    background $bgdark\n    border 1px solid $grayalt\n    color #eee\n    cursor pointer\n    font inherit\n    padding 6px 10px\n\n    &:hover\n      color $primary\n      border-color $primary\n\n    &:disabled\n      opacity .55\n      cursor not-allowed\n\n  button:focus-visible,\n  a:focus-visible,\n  input:focus-visible,\n  select:focus-visible,\n  textarea:focus-visible,\n  [tabindex]:focus-visible\n    outline 2px solid $primary !important\n    outline-offset -2px\n\n  [hidden]\n    display none !important\n\n  code\n    font-family Consolas, Andale Mono, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace\n\n  textarea\n    tab-size 4\n    white-space pre\n    word-wrap normal\n\n  textarea.success\n    border-color #8b8 !important\n\n  textarea.fail\n    background-color rgba(255, 0, 0, 0.05)\n    border-color #f00 !important\n\n  textarea,\n  input\n    outline none /* osx */\n\n  .gltfIcon img\n    box-sizing content-box\n    display inline\n    height 20px\n    left 5px\n    padding 0 5px\n    position relative\n    top 4px\n    vertical-align baseline\n    width 20px\n\n  #sidebar,\n  #scenegraph,\n    .panel\n      cursor default\n      user-select none\n\n  #sceneActions\n    display flex\n    flex-direction row\n    position absolute\n    bottom 0\n    z-index 40\n    width calc(20rem - 48px)\n    height 48px\n    background $bg\n    padding-left 48px\n\n  #sceneActions .sceneActionsTitle\n    letter-spacing 0.1em\n    line-height 1rem\n    font-size 0.75rem\n    padding 0.25rem\n    text-align center\n    background #303032\n    color #989899\n    font-weight 500\n\n  #sceneActions .sceneActionsButton\n    display flex\n\n  .toggle-edit\n    pointer-events auto\n    border 0\n    padding 0\n    background-color $bg\n    box-sizing content-box\n    color white\n    font-size 12px\n    left 0px\n    bottom 0px\n    line-height normal\n    margin 0\n    position absolute\n    text-align center\n    text-decoration none\n    width 48px\n    height 48px\n    display flex\n    align-items center\n    justify-content center\n    z-index 40\n\n  .toggle-edit:hover\n    background-color #141417\n    color white\n\n    svg\n      color $red\n\n  .toggle-save,\n  .toggle-live\n    background-color $bg\n    color white\n    height 40px\n    display flex\n    align-items center\n    justify-content center\n    border 0\n    font-size 16px\n    font-weight 500\n    cursor pointer\n\n  .toggle-save:hover,\n  .toggle-live:hover\n    background-color $bgdark\n\n  #saveSceneBtn\n    width 10rem\n\n  #liveSceneBtn\n    width 10rem\n\n  input\n    border 1px solid #555\n    color #fff\n\n  input,\n  .texture canvas\n    transition 0.1s background-color ease-in-out, 0.1s border-color ease-in-out, 0.1s color ease-in-out\n\n  input[type=text],\n  input[type=number],\n  input.string,\n  input.number\n    min-height 14px\n    outline none\n\n  input[type=\"checkbox\"]\n    appearance auto\n    accent-color $primary\n    cursor pointer\n    margin 0\n    height 18px\n    width 18px\n\n  input[type=\"checkbox\"]:focus\n    box-shadow none\n\n  input.number\n    border 0\n    color white !important\n    cursor col-resize\n    font-size 14px\n    padding 2px\n\n  input.stringfocus,\n  input.numberfocus\n    border 1px solid #00FF99\n    color #fff\n    cursor auto\n\n  input.error\n    border 1px solid #a00\n\n  #sidebar\n    min-height 0\n    background $bg\n    width 100%\n    flex-grow 1\n    overflow-y auto\n\n  #sidebar *\n    vertical-align middle\n\n  input,\n  textarea,\n  select\n    background $black\n    border 1px solid transparent\n    color #888\n\n  select\n    background $bglighter\n\n  input[type=color]\n    background-color #333\n    border 1px solid #111\n    height 28px\n    cursor pointer\n\n  input[type=color]\n    cursor pointer\n    height 25px\n    padding 0\n    width 50px\n\n  /* Note these vendor-prefixed selectors cannot be grouped! */\n  input[type=color]-webkit-color-swatch\n    border 0  /* To remove the gray border. */\n\n  input[type=color]-webkit-color-swatch-wrapper\n    padding 0  /* To remove the inner padding. */\n\n  input[type=color]-moz-color-swatch\n    border 0\n\n  input[type=color]-moz-focus-inner\n    border 0  /* To remove the inner border (specific to Firefox). */\n    padding 0\n\n  .hidden\n    visibility hidden\n    display none !important\n\n  a.button\n    color #A3A3A3\n    font-size 16px\n    margin-left 8px\n    display flex\n    align-items center\n    justify-content center\n    text-decoration none\n\n  a.buttonhover\n    color #00FF99\n\n  @keyframes animateopacity\n    from { opacity: 0 }\n    to { opacity: 1 }\n\n  .hide\n    display none\n\n  .a-canvas.state-dragging\n    cursor grabbing\n\n  #rightPanel\n    top 0\n    width 20rem\n    display flex\n    flex-direction column\n    height calc(100vh - 48px)\n    margin-left auto\n\n  #leftPanel,\n  #rightPanel\n    width 320px\n    max-width calc(100vw - 24px)\n    height calc(100vh - 48px)\n    height calc(100dvh - 48px)\n    min-height 0\n    min-width 0\n    overflow hidden\n    background $bg\n    position relative\n    top auto\n\n  #actionBar\n    display flex\n    align-items center\n    box-sizing border-box\n    padding-left 48px\n    width 100vw\n    height 48px\n    background $bg\n    bottom 0\n    position absolute\n\n    #sw-info\n      display flex\n      flex-direction column\n      justify-content center\n      align-items end\n      width max-content\n      height 100%\n      padding 0 10px\n     