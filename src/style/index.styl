@import './lib';

body.aframe-inspector-opened,
.toggle-edit
  font-family BlinkMacSystemFont, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif

.wf-roboto-n4-active body.aframe-inspector-opened,
.wf-roboto-n4-active .toggle-edit
  font-family BlinkMacSystemFont, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif

body.aframe-inspector-opened
  background $bgdark
  color #fff
  font-size 12px
  margin 0
  overflow hidden

#aframeInspector
  @import './scenegraph';
  @import './components';
  @import './entity';
  @import './help';
  @import './select';
  @import './textureModal';
  @import './viewport';
  @import './widgets';
  @import './primitiveModal';

  .error-boundary
    position fixed
    top 0
    left 0
    width 100%
    height 100%
    display flex
    align-items center
    justify-content center
    background rgba(0, 0, 0, 0.9)
    z-index 9999
    pointer-events all

    .error-content
      background #1e1e1e
      border 1px solid #ff4444
      border-radius 8px
      padding 24px 32px
      max-width 500px
      text-align center

      h2
        color #ff4444
        margin 0 0 16px 0
        font-size 18px

      p
        color #a3a3a3
        margin 0 0 16px 0

      pre
        background #0d0d0d
        color #ff6b6b
        padding 12px
        border-radius 4px
        font-size 12px
        overflow-x auto
        text-align left
        margin 0 0 16px 0

      button
        background #00ff99
        color #000
        border none
        padding 10px 24px
        border-radius 4px
        cursor pointer
        font-weight 500
        font-size 14px

        &:hover
          background #00cc7a

  .Select,
  code,
  pre,
  input,
  textarea,
  select
    font-family $monospace
    font-size 14px

  .wf-robotomono-n4-active .Select,
  .wf-robotomono-n4-active code,
  .wf-robotomono-n4-active pre,
  .wf-robotomono-n4-active input,
  .wf-robotomono-n4-active textarea,
  .wf-robotomono-n4-active select
    font-family Roboto Mono, Consolas, Andale Mono, Monaco, Courier New, monospace

  hr
    border 0
    border-top 1px solid #ccc

  a
    cursor pointer

  button
    position relative

  code
    font-family Consolas, Andale Mono, Monaco, Lucida Console, Liberation Mono, DejaVu Sans Mono, Bitstream Vera Sans Mono, Courier New, monospace

  textarea
    tab-size 4
    white-space pre
    word-wrap normal

  textarea.success
    border-color #8b8 !important

  textarea.fail
    background-color rgba(255, 0, 0, 0.05)
    border-color #f00 !important

  textarea,
  input
    outline none /* osx */

  .gltfIcon img
    box-sizing content-box
    display inline
    height 20px
    left 5px
    padding 0 5px
    position relative
    top 4px
    vertical-align baseline
    width 20px

  #sidebar,
  #scenegraph,
    .panel
      cursor default
      user-select none

  #sceneActions
    display flex
    flex-direction row
    position absolute
    bottom 0
    z-index 40
    width calc(20rem - 48px)
    height 48px
    background $bg
    padding-left 48px

  #sceneActions .sceneActionsTitle
    letter-spacing 0.1em
    line-height 1rem
    font-size 0.75rem
    padding 0.25rem
    text-align center
    background #303032
    color #989899
    font-weight 500

  #sceneActions .sceneActionsButton
    display flex

  .toggle-edit
    background-color $bg
    box-sizing content-box
    color white
    font-size 12px
    left 0px
    bottom 0px
    line-height normal
    margin 0
    position absolute
    text-align center
    text-decoration none
    width 48px
    height 48px
    display flex
    align-items center
    justify-content center
    z-index 40

  .toggle-edit:hover
    background-color #141417
    color white

    svg
      color $red

  .toggle-save,
  .toggle-live
    background-color $bg
    color white
    height 40px
    display flex
    align-items center
    justify-content center
    border 0
    font-size 16px
    font-weight 500
    cursor pointer

  .toggle-save:hover,
  .toggle-live:hover
    background-color $bgdark

  #saveSceneBtn
    width 10rem

  #liveSceneBtn
    width 10rem

  input
    border 1px solid #555
    color #fff

  input,
  .texture canvas
    transition 0.1s background-color ease-in-out, 0.1s border-color ease-in-out, 0.1s color ease-in-out

  input[type=text],
  input[type=number],
  input.string,
  input.number
    min-height 14px
    outline none

  input[type="checkbox"]
    appearance auto
    cursor pointer
    margin 0
    height 18px
    width 18px

  input[type="checkbox"]:focus
    box-shadow none

  input.number
    border 0
    color white !important
    cursor col-resize
    font-size 14px
    padding 2px

  input.stringfocus,
  input.numberfocus
    border 1px solid #00FF99
    color #fff
    cursor auto

  input.error
    border 1px solid #a00

  #sidebar
    background $bg
    width 100%
    flex-grow 1
    overflow-y auto

  #sidebar *
    vertical-align middle

  input,
  textarea,
  select
    background $black
    border 1px solid transparent
    color #888

  select
    background $bglighter

  input[type=color]
    background-color #333
    border 1px solid #111
    height 28px
    cursor pointer

  input[type=color]
    cursor pointer
    height 25px
    padding 0
    width 50px

  /* Note these vendor-prefixed selectors cannot be grouped! */
  input[type=color]-webkit-color-swatch
    border 0  /* To remove the gray border. */

  input[type=color]-webkit-color-swatch-wrapper
    padding 0  /* To remove the inner padding. */

  input[type=color]-moz-color-swatch
    border 0

  input[type=color]-moz-focus-inner
    border 0  /* To remove the inner border (specific to Firefox). */
    padding 0

  .hidden
    visibility hidden

  a.button
    color #A3A3A3
    font-size 16px
    margin-left 8px
    display flex
    align-items center
    justify-content center
    text-decoration none

  a.buttonhover
    color #00FF99

  @keyframes animateopacity
    from { opacity: 0 }
    to { opacity: 1 }

  .hide
    display none

  .a-canvas.state-dragging
    cursor grabbing

  #rightPanel
    top 0
    width 20rem
    display flex
    flex-direction column
    height calc(100vh - 48px)

  #actionBar
    width 100vw
    height 48px
    background $bg
    bottom 0
    position absolute

    #sw-info
      display flex
      flex-direction column
      justify-content center
      align-items end
      width max-content
      height 100%
      padding 0 10px
      margin-left auto
      color $lightgray

  #inspectorContainer
    display flex
    justify-content space-between
    left 0
    height 100%
    pointer-events none
    position fixed
    top 0
    width 100%
    z-index 20

  #scenegraph,
  #viewportBar,
  #actionBar,
  #leftPanel,
  #rightPanel
    pointer-events all

  .aframe-inspector-opened a-scene .a-canvas
    background-color #191919
    z-index 9999

  .toggle-sidebar
    align-items center
    display flex
    height 100%
    position absolute
    z-index 40

    a
      background-color #262626
      color #A3A3A3
      padding 5px
      z-index 40

    a.hover
      background-color #007370
      color #fff

  .toggle-sidebar.left
    top 0
    left 0

  .toggle-sidebar.right
    top 0
    right 0

#rightPanel ::-webkit-scrollbar
#leftPanel ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
}

#rightPanel ::-webkit-scrollbar-track
#leftPanel ::-webkit-scrollbar-track {
    background: #18181B;
}

#rightPanel ::-webkit-scrollbar-thumb
#leftPanel ::-webkit-scrollbar-thumb {
    background: rgba(0, 0, 0, 0.5);
    border-radius: 0;
}

#rightPanel ::-webkit-scrollbar-thumb:hover
#leftPanel ::-webkit-scrollbar-thumb:hover {
    background: rgba(0, 0, 0, 0.75);
}

.swal2-container
  background-color rgba(0, 0, 0, 0) !important

  .swal2-popup
    background #18181B !important
    color #fff !important
    border-radius 8px !important
    padding 2.5rem 1.5rem !important

  .swal2-title
    color #fff !important
    font-size 28px !important
    font-weight 700 !important
    margin 0 !important

  .swal2-html-container
    color #A3A3A3 !important
    font-size 16px !important
    line-height 1.6 !important
    margin 0 !important

  .swal2-icon
    margin-top 0 !important
    border-width 3px !important
    
    &.swal2-warning
      border-color #f8bb86 !important
      color #f8bb86 !important
      
      .swal2-icon-content
        font-size 60px !important

  .swal2-actions
    gap 0.75rem !important
    margin-top 1rem !important
    width 100% !important
    justify-content center !important

  .swal2-confirm, .swal2-cancel
    background #09090B !important
    color #fff !important
    border-radius 0.5rem !important
    padding 14px 28px !important
    font-weight 700 !important
    border none !important
    font-size 16px !important
    margin 0 !important
    transition all 0.2s ease
    
    &:focus
      box-shadow none !important

  .swal2-cancel:hover
    background-color red !important
    color white !important

  .swal2-confirm:hover
    background-color $primary !important
    color #18181B !important

  .swal2-input
    background #09090B !important
    color #fff !important
    border 1px solid #323232 !important
    border-radius 8px !important
    box-shadow none !important
    height 48px !important
    margin 1rem auto !important
    
    &:focus
      border-color $primary !important
      box-shadow none !important


