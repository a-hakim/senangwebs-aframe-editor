@import './lib';

#toolbar
  background-color $bgdark

  .toolbarActions
    padding 0
    height 48px
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))

    a.button
      display flex
      justify-content center
      align-items center
      flex-direction column
      margin 0

      svg
        color inherit

      span
        font-size 12px

    a.button:hover
      color $primary

    a.disabled
      color #666
      cursor default

    .button
      display flex
      align-items center
      justify-content center
      flex-direction column
      margin 0
      border-radius 0
      background $bgdark
      border 0

      span
        font-size 12px

#leftPanel
  display flex
  flex-direction column
  width 20rem
  height calc(100vh - 48px)

.scenegraph-menubar
    flex-shrink 0
    display flex
    height 40px
    width 100%
    justify-content space-between
    background-color $bg
    
#githubLink
    display flex
    align-items center
    gap 8px
    font-size 14px
    height 100%
    width 320px
    color $lightgray
    padding 0 10px
    text-decoration none

    svg
        height 18px

#githubLink:hover
    color $primary

    svg
        color $primary
    
#scenegraph
  background $bg
  border-top 1px solid #111
  display flex
  flex-direction column
  overflow hidden
  width 100%
  height 100%
  min-height 0
  flex 1

  .entity
    background $bg
    cursor pointer
    display flex
    justify-content space-between
    padding 4px 8px
    white-space nowrap
    height 40px
    box-sizing border-box
    align-items center

    .entity-label
      display flex
      align-items center
      min-width 0
      overflow hidden

    .entityPrint
      overflow hidden
      text-overflow ellipsis

    button
      background transparent
      border 0
      padding 3px
      flex-shrink 0

    .entityActions
      flex-shrink 0

    .visibility-button
      width 24px
      height 28px

    .collapsespace
      margin 0
      padding 0
      width 16px

    &:focus-within .entityActions
      display flex

    &:hover
      background $bgdark

    &.active
      background-color #09090B
      color #fff
      .component:hover
        color rgba(0, 0, 0, 0.5)
      .entityActions
        display flex

    &.novisible
      &.active
        span,
        svg,
        .collapsespace,
        .id
          color #999

      &:not(.active)
        span,
        svg,
        .collapsespace,
        .id
          color #626262

    &.drag-before
      border-top 2px solid $primary

    &.drag-after
      border-bottom 2px solid $primary

    &.drag-inside
      background-color $primary
      color $bgdark

  .component:hover
    color rgba(0, 0, 0, 0.5)

  .entityIcons
    margin-left 2px

  .entityActions
    display none
    margin 0 4px

    .button
      color #fff
      font-size 12px
      margin-left 6px

  svg
    color #CCC

  .entityActions svg:hover
    color $primary

  .active svg
    color #FAFAFA

  .id
    color #ccc

  .option.active .id
    color #fff

  .collapsespace
    color #eee
    display inline-block
    text-align center
    width 14px
    margin-left 8px

  .fa-eye
    color #bbb

  .icons a.button
    color #fff

  .search
    display flex
    align-items center
    background $bg
    padding 0px
    font-size 16px
    position relative
    overflow hidden

    input
      min-width 0
      flex 1
      box-sizing border-box
      padding-right 40px
      color $white
      background $bg
      border-radius 0px
      border-bottom 1px solid $bgdark
      height 40px
      text-indent 10px
      width 100%

    button
      position absolute
      right 0
      top 0
      width 40px
      height 40px
      margin 0
      padding 0
      border 0
      background transparent

    svg
      position absolute
      right 12px
      top 12px

  .outliner
    min-height 0
    overflow auto
    overflow-anchor none
    background $bg
    color $white
    cursor default
    flex 1 1 auto
    font-size 14px
    line-height normal
    outline none
    overflow-y auto
    padding 0px
    width 100%

.scenegraph-bottom
  background-color #323232
  border-top 1px solid #111
  bottom 10
  height 40px
  left 0
  z-index 100

  a
    float right
    margin 10px
